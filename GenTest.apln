:Namespace GenTest
    ⍝ Generative tester for the SFTP library.
    ⍝ Maintains a model of the remote filesystem tree, applies random
    ⍝ operations, and verifies the server matches the model.
    ⍝
    ⍝ Usage:  GenTest.Run n seed
    ⍝   n>0: run n iterations     e.g.  GenTest.Run 100 42
    ⍝   n<0: run for |n seconds   e.g.  GenTest.Run ¯900 42

    ⎕IO←0

    ⍝ ── Path helpers ────────────────────────────────────────────────
    _basename←{v←,⍵ ⋄ (1+⊃⌽⍸'/'=v)↓v}
    _dirname←{v←,⍵ ⋄ p←⊃⌽⍸'/'=v ⋄ p=0:'/' ⋄ p↑v}
    _randname←{⎕A[?⍵⍴26]}
    _pick←{(?≢⍵)⊃⍵}
    _fpaths←{(0=≢⍵):⍬ ⋄ 0⊃¨⍵}  ⍝ extract paths from model.files (safe on empty)

    ⍝ Children of dir d among paths ps (returns basenames)
    ∇ r←d _children ps;mask
        r←⍬ ⋄ →(0=≢ps)/0
        mask←d∘≡¨_dirname¨ps
        r←_basename¨mask/ps
    ∇

    ⍝ Full remote path from base and relative path
    _fullpath←{⍺,(⍵≢'/')/⍵}

    ⍝ ── Main entry point ───────────────────────────────────────────
    ∇ Run(n seed);conn;base;model;i;op;ops;counts;fails;t0;elapsed;timed
        ⎕RL←seed
        timed←n<0
        ops←'mkdir' 'put' 'get' 'list' 'stat' 'rename' 'delete' 'rmdir' 'download' 'upload' 'negative'
        counts←(≢ops)⍴0
        fails←0
        base←'/tmp/aplsftp-fuzz-',⍕seed

        conn←#.SFTP.ConnectWithKey '89.167.123.234' 22 'root' '/tmp/aplsftp-test-key' ''
        ⎕←'Connected. Base: ',base

        ⍝ Create base directory (clean up leftover if exists)
        :Trap 810 ⋄ #.SFTP.Mkdir conn base
        :Else ⋄ _nuke conn base ⋄ #.SFTP.Mkdir conn base
        :EndTrap
        model←⎕NS''
        model.dirs←,⊂'/'
        model.files←⍬

        t0←2⊃⎕AI ⋄ i←0
        :While timed∨i<n
            :If timed∧(1000×|n)<(2⊃⎕AI)-t0 ⋄ :Leave ⋄ :EndIf
            i+←1
            ⍝ Bias toward constructive ops when tree is small
            :If (≢model.files)<3 ⋄ op←?2 ⋄ :Else ⋄ op←?≢ops ⋄ :EndIf
            counts[op]+←1
            :Trap 810 99
                :Select op
                :Case 0 ⋄ _mkdir conn base model
                :Case 1 ⋄ _put conn base model
                :Case 2 ⋄ _get conn base model
                :Case 3 ⋄ _list conn base model
                :Case 4 ⋄ _stat conn base model
                :Case 5 ⋄ _rename conn base model
                :Case 6 ⋄ _delete conn base model
                :Case 7 ⋄ _rmdir conn base model
                :Case 8 ⋄ _download conn base model
                :Case 9 ⋄ _upload conn base model
                :Case 10 ⋄ _negative conn base model
                :EndSelect
            :Else
                fails+←1
                ⎕←'  FAIL #',(⍕i),' ',(op⊃ops),': ',(⍕⎕DMX.EN),' ',⎕DMX.Message
            :EndTrap
        :EndWhile

        ⍝ Final verification: re-read every file and compare
        _verify conn base model

        ⍝ Clean up remote tree
        _cleanup conn base model
        #.SFTP.Disconnect conn

        ⍝ Summary
        elapsed←((2⊃⎕AI)-t0)÷1000
        ⎕←''
        ⎕←'=== Summary ==='
        ⎕←'Iterations: ',(⍕i),' in ',(⍕elapsed),'s'
        ⎕←↑(ops,¨':'),¨' ',¨⍕¨counts
        ⎕←'Failures: ',⍕fails
        ⎕←'Seed: ',⍕seed
    ∇

    ⍝ ── Operations ─────────────────────────────────────────────────

    ∇ _mkdir(conn base model);parent;name;path;nonroot
        nonroot←model.dirs~⊂'/'
        :If (0<≢nonroot)∧0=?2
            parent←_pick nonroot
        :Else
            parent←_pick model.dirs
        :EndIf
        name←_randname 4+?5
        path←(('/'≡parent)↓parent),'/',name
        #.SFTP.Mkdir conn(base,path)
        model.dirs,←⊂path
        ⎕←'  mkdir ',path
    ∇

    ∇ _put(conn base model);dir;name;path;data;text
        dir←_pick model.dirs
        name←(_randname 4+?5),'.dat'
        path←(('/'≡dir)↓dir),'/',name
        text←0=?3
        :If text  ⍝ ~33%: character data (exercises UTF-8 auto-conversion)
            data←⎕UCS 32+?(1+?200)⍴(95+900×0=?2)
            #.SFTP.Put conn data(base,path)
            data←'UTF-8'⎕UCS data
        :Else
            data←?(1+?999+39001×0=?5)⍴256
            #.SFTP.Put conn data(base,path)
        :EndIf
        model.files←(path∘≢¨_fpaths model.files)/model.files
        model.files,←⊂path data
        ⎕←'  put ',path,' (',(⍕≢data),' bytes',(text/' text'),')'
    ∇

    ∇ _get(conn base model);idx;entry;path;expected;actual
        →(0=≢model.files)/0
        idx←?≢model.files
        entry←idx⊃model.files
        path←0⊃entry
        expected←1⊃entry
        actual←#.SFTP.Get conn(base,path)
        :If expected≢actual
            ⎕←'  GET MISMATCH: ',path,' expected ',(⍕≢expected),' got ',(⍕≢actual),' bytes'
            ('get mismatch: ',path)⎕SIGNAL 99
        :Else
            ⎕←'  get ',path,' OK'
        :EndIf
    ∇

    ∇ _list(conn base model);dir;actual;anames;edirs;efiles;enames;filtered;entry;name;fpath;midx;esize;asize
        dir←_pick model.dirs
        actual←#.SFTP.List conn(base _fullpath dir)
        anames←⊃¨actual
        anames←(~anames∊(,'.') '..')/anames
        ⍝ Expected: children of dir in model
        edirs←dir _children model.dirs~⊂dir
        efiles←dir _children _fpaths model.files
        enames←edirs,efiles
        :If (≢enames)≠≢anames
            ⎕←'  LIST COUNT MISMATCH in ',dir,': expected ',(⍕≢enames),' got ',⍕≢anames
            ⎕←'    expected: ',⍕enames
            ⎕←'    actual:   ',⍕anames
            ('list mismatch: ',dir)⎕SIGNAL 99
        :ElseIf (0<≢enames)∧~∧/enames∊anames
            ⎕←'  LIST CONTENT MISMATCH in ',dir
            ⎕←'    expected: ',⍕enames
            ⎕←'    actual:   ',⍕anames
            ('list mismatch: ',dir)⎕SIGNAL 99
        :Else
            ⍝ Check file sizes in listing attrs
            filtered←(~(⊃¨actual)∊(,'.') '..')/actual
            :For entry :In filtered
                name←0⊃entry
                :If (⊂name)∊efiles
                    fpath←(('/'≡dir)↓dir),'/',name
                    midx←(_fpaths model.files)⍳⊂fpath
                    esize←≢1⊃midx⊃model.files
                    asize←(1⊃entry)[1]
                    :If esize≠asize
                        ⎕←'  LIST SIZE MISMATCH: ',fpath,' expected ',(⍕esize),' got ',⍕asize
                        ('list size mismatch: ',fpath)⎕SIGNAL 99
                    :EndIf
                :EndIf
            :EndFor
            ⎕←'  list ',dir,' OK (',(⍕≢anames),' entries)'
        :EndIf
    ∇

    ∇ _stat(conn base model);idx;entry;path;expected_size;attrs;perms
        →(0=≢model.files)/0
        idx←?≢model.files
        entry←idx⊃model.files
        path←0⊃entry
        expected_size←≢1⊃entry
        attrs←#.SFTP.Stat conn(base,path)
        :If expected_size≠attrs.filesize
            ⎕←'  STAT SIZE MISMATCH: ',path,' expected ',(⍕expected_size),' got ',⍕attrs.filesize
            ('stat mismatch: ',path)⎕SIGNAL 99
        :EndIf
        perms←4096|attrs.permissions
        :If perms≠8⊥6 4 4
            ⎕←'  STAT PERMS MISMATCH: ',path,' expected 0644 got ',⍕perms
            ('stat perms mismatch: ',path)⎕SIGNAL 99
        :EndIf
        ⎕←'  stat ',path,' OK (',(⍕expected_size),' bytes)'
    ∇

    ∇ _rename(conn base model);idx;entry;oldpath;dir;newname;newpath;data
        →(0=≢model.files)/0
        idx←?≢model.files
        entry←idx⊃model.files
        oldpath←0⊃entry
        data←1⊃entry
        dir←_pick model.dirs              ⍝ random destination dir (cross-dir rename)
        newname←(_randname 4+?5),'.dat'
        newpath←(('/'≡dir)↓dir),'/',newname
        #.SFTP.Rename conn(base,oldpath)(base,newpath)
        model.files←(idx≠⍳≢model.files)/model.files            ⍝ remove old
        model.files←(newpath∘≢¨_fpaths model.files)/model.files ⍝ remove collision if any
        model.files,←⊂newpath data                              ⍝ add renamed
        ⎕←'  rename ',oldpath,' → ',newpath
    ∇

    ∇ _delete(conn base model);idx;path
        →(0=≢model.files)/0
        idx←?≢model.files
        path←0⊃idx⊃model.files
        #.SFTP.Delete conn(base,path)
        model.files←(idx≠⍳≢model.files)/model.files
        ⎕←'  delete ',path
    ∇

    ∇ _rmdir(conn base model);candidates;empty;dir
        ⍝ Only remove empty, non-root dirs
        candidates←model.dirs~⊂'/'
        →(0=≢candidates)/0
        empty←0⍴0
        :For dir :In candidates
            empty,←0=≢(dir _children model.dirs~⊂dir),dir _children _fpaths model.files
        :EndFor
        candidates←empty/candidates
        →(0=≢candidates)/0
        dir←_pick candidates
        #.SFTP.Rmdir conn(base,dir)
        model.dirs←model.dirs~⊂dir
        ⎕←'  rmdir ',dir
    ∇

    ∇ _download(conn base model);idx;entry;path;expected;localpath;tn;actual
        →(0=≢model.files)/0
        idx←?≢model.files
        entry←idx⊃model.files
        path←0⊃entry
        expected←1⊃entry
        localpath←'/private/tmp/aplsftp-test/gentest-tmp'
        :Trap 0 ⋄ ⎕NDELETE localpath ⋄ :EndTrap
        #.SFTP.Download conn(base,path)localpath
        tn←localpath ⎕NTIE 0
        actual←256|⎕NREAD tn 83(⎕NSIZE tn)
        ⎕NUNTIE tn
        :Trap 0 ⋄ ⎕NDELETE localpath ⋄ :EndTrap
        :If expected≢actual
            ⎕←'  DOWNLOAD MISMATCH: ',path,' expected ',(⍕≢expected),' got ',(⍕≢actual),' bytes'
            ('download mismatch: ',path)⎕SIGNAL 99
        :Else
            ⎕←'  download ',path,' OK'
        :EndIf
    ∇

    ∇ _upload(conn base model);dir;name;path;data;localpath;tn;actual
        dir←_pick model.dirs
        name←(_randname 4+?5),'.dat'
        path←(('/'≡dir)↓dir),'/',name
        data←?(1+?999)⍴256
        localpath←'/private/tmp/aplsftp-test/gentest-tmp'
        :Trap 0 ⋄ ⎕NDELETE localpath ⋄ :EndTrap
        tn←localpath ⎕NCREATE 0
        (⎕UCS data) ⎕NAPPEND tn 80
        ⎕NUNTIE tn
        #.SFTP.Upload conn localpath(base,path)
        :Trap 0 ⋄ ⎕NDELETE localpath ⋄ :EndTrap
        actual←#.SFTP.Get conn(base,path)
        :If data≢actual
            ⎕←'  UPLOAD MISMATCH: ',path,' expected ',(⍕≢data),' got ',(⍕≢actual),' bytes'
            ('upload mismatch: ',path)⎕SIGNAL 99
        :Else
            model.files←(path∘≢¨_fpaths model.files)/model.files  ⍝ remove collision if any
            model.files,←⊂path data
            ⎕←'  upload ',path,' OK (',(⍕≢data),' bytes)'
        :EndIf
    ∇

    ∇ _negative(conn base model);ok;scenario;dir;children;found
        scenario←?5
        :Select scenario
        :Case 0  ⍝ Get nonexistent file
            ok←0
            :Trap 810 ⋄ #.SFTP.Get conn(base,'/nonexistent-',_randname 8) ⋄ ok←1 ⋄ :EndTrap
            :If ok ⋄ ('expected error: get nonexistent')⎕SIGNAL 99 ⋄ :EndIf
            ⎕←'  negative: get nonexistent OK'
        :Case 1  ⍝ Delete nonexistent file
            ok←0
            :Trap 810 ⋄ #.SFTP.Delete conn(base,'/nonexistent-',_randname 8) ⋄ ok←1 ⋄ :EndTrap
            :If ok ⋄ ('expected error: delete nonexistent')⎕SIGNAL 99 ⋄ :EndIf
            ⎕←'  negative: delete nonexistent OK'
        :Case 2  ⍝ Stat nonexistent path
            ok←0
            :Trap 810 ⋄ #.SFTP.Stat conn(base,'/nonexistent-',_randname 8) ⋄ ok←1 ⋄ :EndTrap
            :If ok ⋄ ('expected error: stat nonexistent')⎕SIGNAL 99 ⋄ :EndIf
            ⎕←'  negative: stat nonexistent OK'
        :Case 3  ⍝ Mkdir existing directory
            dir←_pick model.dirs
            ok←0
            :Trap 810 ⋄ #.SFTP.Mkdir conn(base _fullpath dir) ⋄ ok←1 ⋄ :EndTrap
            :If ok ⋄ ('expected error: mkdir existing ',dir)⎕SIGNAL 99 ⋄ :EndIf
            ⎕←'  negative: mkdir existing OK (',dir,')'
        :Case 4  ⍝ Rmdir non-empty directory (find one with children)
            found←0 ⋄ dir←'/'
            :For dir :In model.dirs
                children←(dir _children model.dirs~⊂dir),dir _children _fpaths model.files
                :If 0<≢children ⋄ found←1 ⋄ :Leave ⋄ :EndIf
            :EndFor
            :If ~found
                ⎕←'  negative: rmdir non-empty SKIP (no non-empty dirs)'
            :Else
                ok←0
                :Trap 810 ⋄ #.SFTP.Rmdir conn(base _fullpath dir) ⋄ ok←1 ⋄ :EndTrap
                :If ok ⋄ ('expected error: rmdir non-empty ',dir)⎕SIGNAL 99 ⋄ :EndIf
                ⎕←'  negative: rmdir non-empty OK (',dir,')'
            :EndIf
        :EndSelect
    ∇

    ⍝ ── Verification ───────────────────────────────────────────────

    ∇ _verify(conn base model);entry;path;expected;actual;ok;dir;listing;anames;edirs;efiles;enames;extra;missing
        ⎕←''
        ⎕←'=== Verification ==='
        ok←1
        ⍝ Check file contents
        :For entry :In model.files
            path←0⊃entry
            expected←1⊃entry
            actual←#.SFTP.Get conn(base,path)
            :If expected≢actual
                ⎕←'  FAIL: ',path
                ok←0
            :Else
                ⎕←'  OK: ',path
            :EndIf
        :EndFor
        ⍝ Check directory structure
        :For dir :In model.dirs
            listing←#.SFTP.List conn(base _fullpath dir)
            anames←⊃¨listing
            anames←(~anames∊(,'.') '..')/anames
            edirs←dir _children model.dirs~⊂dir
            efiles←dir _children _fpaths model.files
            enames←edirs,efiles
            extra←(~anames∊enames)/anames
            missing←(~enames∊anames)/enames
            :If (0<≢extra)∨0<≢missing
                ⎕←'  DIR MISMATCH: ',dir
                :If 0<≢extra ⋄ ⎕←'    orphans: ',⍕extra ⋄ :EndIf
                :If 0<≢missing ⋄ ⎕←'    missing: ',⍕missing ⋄ :EndIf
                ok←0
            :Else
                ⎕←'  DIR OK: ',dir,' (',(⍕≢anames),' entries)'
            :EndIf
        :EndFor
        :If ok
            ⎕←'All ',(⍕≢model.files),' files and ',(⍕≢model.dirs),' dirs verified.'
        :EndIf
    ∇

    ⍝ ── Cleanup ────────────────────────────────────────────────────

    ∇ _nuke(conn path);entries;names;name;sub
        ⍝ Recursively remove remote directory tree
        :Trap 810 ⋄ entries←#.SFTP.List conn path ⋄ :Else ⋄ :Return ⋄ :EndTrap
        names←(~(⊃¨entries)∊(,'.') '..')/⊃¨entries
        :For name :In names
            sub←path,'/',name
            :Trap 810 ⋄ #.SFTP.Delete conn sub ⋄ :Else ⋄ _nuke conn sub ⋄ :EndTrap
        :EndFor
        :Trap 810 ⋄ #.SFTP.Rmdir conn path ⋄ :EndTrap
    ∇

    ∇ _cleanup(conn base model);sorted;entry;d
        ⍝ Delete all files
        :For entry :In model.files
            :Trap 0 ⋄ #.SFTP.Delete conn(base,0⊃entry) ⋄ :EndTrap
        :EndFor
        ⍝ Remove dirs deepest first, skip root
        sorted←{⍵[⍒≢¨⍵]}model.dirs~⊂'/'
        :For d :In sorted
            :Trap 0 ⋄ #.SFTP.Rmdir conn(base,d) ⋄ :EndTrap
        :EndFor
        :Trap 0 ⋄ #.SFTP.Rmdir conn base ⋄ :EndTrap
        ⎕←'Cleaned up.'
    ∇

:EndNamespace
